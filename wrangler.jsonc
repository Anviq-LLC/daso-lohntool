{
  "name": "daso-lohntool",
  "account_id": "de81ba1a2e7bae6a87821b398353b8dd",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": { "directory": "dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "daso-lohntool", "database_id": "ef104d2a-1a3e-4774-84d9-5d3851b71bd1", "migrations_dir": "migrations" },
    { "binding": "PLAN", "database_name": "daso-montageplanung", "database_id": "42f5d224-bb84-4fd2-a1f8-d6abfda88956" },
    { "binding": "AUFMASS", "database_name": "daso-aufmass-eu", "database_id": "b7dcd995-d426-4809-bb1f-60ffe3d1513b" }
  ]
}
